{"data": {"conn_name": "macro_log_macro_results", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.12.3\", \"dbt_databricks_version\": \"1.12.5\", \"databricks_sql_connector_version\": \"4.4.0\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"invocation_id\": \"6fd9be71-f0fb-4bc1-9d74-fc181036cd27\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"6fd9be71-f0fb-4bc1-9d74-fc181036cd27\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n            with tests as (\n                select * from `bronze_production`.`cdc_staging`.`dbt_tests`\n            ),\n            \n            test_results as (\n                select * from `bronze_production`.`cdc_staging`.`elementary_test_results`\n            ),\n\n            models as (\n                select * from `bronze_production`.`cdc_staging`.`dbt_models`\n            ),\n            \n            sources as (\n                select * from `bronze_production`.`cdc_staging`.`dbt_sources`\n            ),\n\n            nodes as (\n                select\n                    models.unique_id as unique_id,\n                    models.name as name,\n                    models.meta,\n                    models.tags,\n                    'model' as type\n                from models\n                union all\n                select\n                    sources.unique_id as unique_id,\n                    sources.name as name,\n                    sources.meta,\n                    sources.tags,\n                    'source' as type\n                from sources\n            ),\n\n            test_results_times as (\n                select\n                    test_unique_id,\n                    max(detected_at) as last_detected_at,\n                    min(detected_at) as first_detected_at\n                from test_results\n                group by test_unique_id\n            ),\n\n            last_test_results as (\n                select\n                    test_results.test_unique_id,\n                    test_results.detected_at,\n                    test_results.status,\n                    test_results.test_type,\n                    test_results.test_sub_type\n                from test_results\n                join test_results_times \n                    on test_results_times.test_unique_id = test_results.test_unique_id\n                    and test_results_times.last_detected_at = test_results.detected_at\n            )\n\n            select\n                tests.unique_id as unique_id,\n                tests.parent_model_unique_id as model_unique_id,\n                tests.database_name,\n                tests.schema_name,\n                nodes.name as model_name,\n                tests.test_column_name as column_name,\n                tests.name as name,\n                tests.description,\n                tests.package_name,\n                tests.original_path,\n                tests.test_params,\n                tests.meta as meta,\n                nodes.meta as model_meta,\n                tests.tags,\n                nodes.tags as model_tags,\n                tests.type as type,\n                last_test_results.test_type,\n                last_test_results.test_sub_type,\n                test_results_times.first_detected_at as created_at,\n                last_test_results.detected_at as latest_run_time,\n                last_test_results.status as latest_run_status\n            from tests\n            left join test_results_times on tests.unique_id = test_results_times.test_unique_id\n            left join last_test_results on tests.unique_id = last_test_results.test_unique_id\n            left join nodes on tests.parent_model_unique_id = nodes.unique_id\n        \n\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "6fd9be71-f0fb-4bc1-9d74-fc181036cd27", "level": "debug", "msg": "On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.12.3\", \"dbt_databricks_version\": \"1.12.5\", \"databricks_sql_connector_version\": \"4.4.0\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"invocation_id\": \"6fd9be71-f0fb-4bc1-9d74-fc181036cd27\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"6fd9be71-f0fb-4bc1-9d74-fc181036cd27\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n            with tests as (\n                select * from `bronze_production`.`cdc_staging`.`dbt_tests`\n            ),\n            \n            test_results as (\n                select * from `bronze_production`.`cdc_staging`.`elementary_test_results`\n            ),\n\n            models as (\n                select * from `bronze_production`.`cdc_staging`.`dbt_models`\n            ),\n            \n            sources as (\n                select * from `bronze_production`.`cdc_staging`.`dbt_sources`\n            ),\n\n            nodes as (\n                select\n                    models.unique_id as unique_id,\n                    models.name as name,\n                    models.meta,\n                    models.tags,\n                    'model' as type\n                from models\n                union all\n                select\n                    sources.unique_id as unique_id,\n                    sources.name as name,\n                    sources.meta,\n                    sources.tags,\n                    'source' as type\n                from sources\n            ),\n\n            test_results_times as (\n                select\n                    test_unique_id,\n                    max(detected_at) as last_detected_at,\n                    min(detected_at) as first_detected_at\n                from test_results\n                group by test_unique_id\n            ),\n\n            last_test_results as (\n                select\n                    test_results.test_unique_id,\n                    test_results.detected_at,\n                    test_results.status,\n                    test_results.test_type,\n                    test_results.test_sub_type\n                from test_results\n                join test_results_times \n                    on test_results_times.test_unique_id = test_results.test_unique_id\n                    and test_results_times.last_detected_at = test_results.detected_at\n            )\n\n            select\n                tests.unique_id as unique_id,\n                tests.parent_model_unique_id as model_unique_id,\n                tests.database_name,\n                tests.schema_name,\n                nodes.name as model_name,\n                tests.test_column_name as column_name,\n                tests.name as name,\n                tests.description,\n                tests.package_name,\n                tests.original_path,\n                tests.test_params,\n                tests.meta as meta,\n                nodes.meta as model_meta,\n                tests.tags,\n                nodes.tags as model_tags,\n                tests.type as type,\n                last_test_results.test_type,\n                last_test_results.test_sub_type,\n                test_results_times.first_detected_at as created_at,\n                last_test_results.detected_at as latest_run_time,\n                last_test_results.status as latest_run_status\n            from tests\n            left join test_results_times on tests.unique_id = test_results_times.test_unique_id\n            left join last_test_results on tests.unique_id = last_test_results.test_unique_id\n            left join nodes on tests.parent_model_unique_id = nodes.unique_id\n        \n\n  ", "name": "SQLQuery", "pid": 29209, "thread": "MainThread", "ts": "2026-09-23T21:13:59.051821Z"}}
