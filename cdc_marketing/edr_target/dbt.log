{"data": {"conn_name": "macro_log_macro_results", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.12.3\", \"dbt_databricks_version\": \"1.12.5\", \"databricks_sql_connector_version\": \"4.4.0\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"invocation_id\": \"638fc167-f19d-4ea8-9f26-bb90d21eff72\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \nSELECT\n  table_name,\n  if(table_type IN ('EXTERNAL', 'MANAGED', 'MANAGED_SHALLOW_CLONE', 'EXTERNAL_SHALLOW_CLONE'), 'table', lower(table_type)) AS table_type,\n  lower(data_source_format) AS file_format,\n  table_owner,\n  if(\n    table_type IN (\n      'EXTERNAL',\n      'MANAGED',\n      'MANAGED_SHALLOW_CLONE',\n      'EXTERNAL_SHALLOW_CLONE'\n    ),\n    lower(table_type),\n    NULL\n  ) AS databricks_table_type\nFROM `system`.`information_schema`.`tables`\nWHERE table_catalog = 'bronze_production'\n  AND table_schema = 'cdc_staging_elementary'\n\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "638fc167-f19d-4ea8-9f26-bb90d21eff72", "level": "debug", "msg": "On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.12.3\", \"dbt_databricks_version\": \"1.12.5\", \"databricks_sql_connector_version\": \"4.4.0\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"invocation_id\": \"638fc167-f19d-4ea8-9f26-bb90d21eff72\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \nSELECT\n  table_name,\n  if(table_type IN ('EXTERNAL', 'MANAGED', 'MANAGED_SHALLOW_CLONE', 'EXTERNAL_SHALLOW_CLONE'), 'table', lower(table_type)) AS table_type,\n  lower(data_source_format) AS file_format,\n  table_owner,\n  if(\n    table_type IN (\n      'EXTERNAL',\n      'MANAGED',\n      'MANAGED_SHALLOW_CLONE',\n      'EXTERNAL_SHALLOW_CLONE'\n    ),\n    lower(table_type),\n    NULL\n  ) AS databricks_table_type\nFROM `system`.`information_schema`.`tables`\nWHERE table_catalog = 'bronze_production'\n  AND table_schema = 'cdc_staging_elementary'\n\n  ", "name": "SQLQuery", "pid": 16424, "thread": "MainThread", "ts": "2026-09-23T19:59:29.623346Z"}}
