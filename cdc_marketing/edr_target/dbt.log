{"data": {"conn_name": "macro_log_macro_results", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.12.3\", \"dbt_databricks_version\": \"1.12.5\", \"databricks_sql_connector_version\": \"4.4.0\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"invocation_id\": \"638fc167-f19d-4ea8-9f26-bb90d21eff72\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"638fc167-f19d-4ea8-9f26-bb90d21eff72\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n  \n    \n      \n    \n  \n\n  create or replace temporary view `ordered_test_results__tmp_20260923195931519887`\n  as \n        with test_results as (\n            \n    with elementary_test_results as (\n        select * from `bronze_production`.`cdc_staging_elementary`.`elementary_test_results`\n        \n            where \n        \n        datediff(\n\n    coalesce(date(\n    current_timestamp::timestamp\n), nvl2(date(\n    current_timestamp::timestamp\n), assert_true(date(\n    current_timestamp::timestamp\n) is not null), null))\n\n, \n\n    coalesce(date(cast(detected_at as timestamp)), nvl2(date(cast(detected_at as timestamp)), assert_true(date(cast(detected_at as timestamp)) is not null), null))\n\n) < 90\n        \n    ),\n\n    dbt_run_results as (\n        select * from `bronze_production`.`cdc_staging_elementary`.`dbt_run_results`\n        \n            where \n        \n        datediff(\n\n    coalesce(date(\n    current_timestamp::timestamp\n), nvl2(date(\n    current_timestamp::timestamp\n), assert_true(date(\n    current_timestamp::timestamp\n) is not null), null))\n\n, \n\n    coalesce(date(cast(execute_completed_at as timestamp)), nvl2(date(cast(execute_completed_at as timestamp)), assert_true(date(cast(execute_completed_at as timestamp)) is not null), null))\n\n) < 90\n        \n    ),\n\n    dbt_tests as (\n        select * from `bronze_production`.`cdc_staging_elementary`.`dbt_tests`\n    ),\n\n    dbt_models as (\n        select * from `bronze_production`.`cdc_staging_elementary`.`dbt_models`\n    ),\n\n    dbt_sources as (\n        select * from `bronze_production`.`cdc_staging_elementary`.`dbt_sources`\n    ),\n\n    dbt_artifacts as (\n        select unique_id, meta, tags, owner from dbt_models\n        union all\n        select unique_id, meta, tags, owner from dbt_sources\n    ),\n\n    first_time_test_occurred as (\n        select \n            min(detected_at) as first_time_occurred,\n            test_unique_id\n        from elementary_test_results\n        group by test_unique_id\n    )\n\n    select\n        elementary_test_results.id,\n        \n        case\n            when elementary_test_results.test_type = 'schema_change' then elementary_test_results.test_unique_id\n            \n            when dbt_tests.short_name = 'dimension_anomalies' then elementary_test_results.test_unique_id\n            else coalesce(elementary_test_results.test_unique_id, 'None') || '.' || coalesce(nullif(elementary_test_results.column_name, ''), 'None') || '.' || coalesce(elementary_test_results.test_sub_type, 'None')\n        end as elementary_unique_id,\n        elementary_test_results.invocation_id,\n        elementary_test_results.data_issue_id,\n        elementary_test_results.test_execution_id,\n        elementary_test_results.test_unique_id,\n        elementary_test_results.model_unique_id,\n        elementary_test_results.detected_at,\n        elementary_test_results.database_name,\n        elementary_test_results.schema_name,\n        elementary_test_results.table_name,\n        elementary_test_results.column_name,\n        elementary_test_results.test_type,\n        elementary_test_results.test_sub_type,\n        elementary_test_results.test_results_description,\n        elementary_test_results.owners,\n        elementary_tes